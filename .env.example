# Copy to .env and edit. `docker compose` reads this file automatically, and
# deploy/oracle-cloud-setup.sh writes it for you on the server.

# --- accounts ---------------------------------------------------------------
# The account that adopts portfolios created before multi-user support. It is
# created from the password printed on the first start.
PAPER_TRADER_OWNER_EMAIL=owner@localhost

# Empty = anyone with the link can sign up. Set a word to require an invite
# code instead (the register form then asks for it).
# PAPER_TRADER_REGISTRATION_CODE=

# --- AI analysis ------------------------------------------------------------
# The desktop build talks to Ollama. A server normally has none, so point the
# analysis at any OpenAI-compatible endpoint. LLM_BASE_URL wins when set.
# Examples:
#   DeepSeek   LLM_BASE_URL=https://api.deepseek.com/v1        LLM_MODEL=deepseek-chat
#   OpenAI     LLM_BASE_URL=https://api.openai.com/v1          LLM_MODEL=gpt-4o-mini
#   Groq       LLM_BASE_URL=https://api.groq.com/openai/v1     LLM_MODEL=llama-3.3-70b-versatile
#   local vLLM LLM_BASE_URL=http://10.0.0.5:8000/v1            LLM_MODEL=your-model
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
LLM_TIMEOUT_S=300

# Only used when LLM_BASE_URL is empty. Blank keeps the built-in default
# (http://localhost:11434). From a container on Linux,
# http://host.docker.internal:11434 reaches an Ollama on the Docker host.
# OLLAMA_BASE_URL=
OLLAMA_TIMEOUT_S=600

# --- misc -------------------------------------------------------------------
TZ=Europe/Bucharest
